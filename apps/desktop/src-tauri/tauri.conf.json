{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Hourglass Tracker",
  "version": "0.1.0",
  "identifier": "com.brachio.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hourglass Tracker",
        "width": 420,
        "height": 280,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false
      },
      {
        "label": "settings",
        "title": "Preferences",
        "url": "/?window=settings",
        "width": 480,
        "height": 590,
        "resizable": false,
        "visible": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {}
}
