{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Sunadokei",
  "version": "0.1.0",
  "identifier": "com.brachio.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sunadokei 砂時計",
        "width": 420,
        "height": 280,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false
      },
      {
        "label": "settings",
        "title": "Sunadokei 砂時計 - Preferences",
        "url": "/?window=settings",
        "width": 760,
        "height": 540,
        "minWidth": 680,
        "minHeight": 480,
        "resizable": true,
        "visible": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
